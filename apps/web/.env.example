# Copy to .env.local and fill in from the Supabase project settings.

# Project URL and anon (publishable) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key — bypasses RLS. Server-side only. Never expose to the browser
# and never commit. Used by the public booking route to call
# create_booking_request() after computing the price server-side.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# The pricing/validation rules are wall-clock rules (22:00 closing, business-day
# hold expiry) evaluated with local date getters. The server MUST run in Berlin
# time or those rules shift. Netlify: set this in the site environment too.
TZ=Europe/Berlin

# Optional but recommended once deployed. The magic-link login flow needs an
# absolute redirect URL; without this it falls back to the incoming request's
# Origin header, which isn't always forwarded reliably behind every proxy/CDN
# setup. Set to the real deployed URL, e.g. https://vs.kidbike.de (no trailing
# slash). Leave unset for local dev — localhost works via the fallback.
NEXT_PUBLIC_SITE_URL=

# Transactional email (Resend). Both must be set or no mail is sent at all —
# that is a deliberate no-op, not an error: bookings still work in an
# environment with no mail configured (a preview deploy, local dev), they just
# don't notify anyone. See apps/web/lib/mail.ts.
#
# MAIL_FROM must be at a domain verified in Resend, and it is what recipients
# see as the sender. A display name is allowed:
#   MAIL_FROM="KidBike Verkehrsschulen <verkehrsschulen@kidbike.de>"
RESEND_API_KEY=
MAIL_FROM=

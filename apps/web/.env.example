# Copy to .env.local and fill in from the Supabase project settings.

# Project URL and anon (publishable) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key — bypasses RLS. Server-side only. Never expose to the browser
# and never commit. Used by the public booking route to call
# create_booking_request() after computing the price server-side.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# The pricing/validation rules are wall-clock rules (22:00 closing, business-day
# hold expiry) evaluated with local date getters. The server MUST run in Berlin
# time or those rules shift. Netlify: set this in the site environment too.
TZ=Europe/Berlin
